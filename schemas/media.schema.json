{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scienceos.app/link/v1/atlas-media.schema.json",
  "title": "ScienceOS Atlas - media store catalogue (repo-local; not part of Link v1)",
  "description": "c/<kind>/<key>.json and manifest.json of the Discover media store (contract v1). An asset maps 1:1 onto Link v1 $defs.Photo (url, source, license, attribution, attributionUrl, confidence, fetchedAt) plus the store's own fields.",
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arxiv": {"type": "string"},
        "orcid": {"type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"},
        "wikidata": {"type": "string", "pattern": "^Q\\d+$"},
        "openalex": {"type": "string", "pattern": "^A\\d+$"},
        "ror": {"type": "string", "pattern": "^[0-9a-z]+$"},
        "github": {"type": "string"},
        "bluesky": {"type": "string"}
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "url", "hosted", "source", "fetchedAt"],
      "properties": {
        "role": {"enum": ["photo", "logo", "thumbnail"]},
        "url": {"type": "string", "maxLength": 2048},
        "hosted": {"type": "boolean"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "mime": {"enum": ["image/webp", "image/jpeg"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "source": {"enum": ["wikidata_commons", "github", "bluesky", "homepage_icon", "favicon", "arxiv_pdf"]},
        "sourceUrl": {"type": "string", "maxLength": 2048},
        "license": {"type": "string", "maxLength": 64},
        "licenseUrl": {"type": "string", "maxLength": 2048},
        "attribution": {"type": "string", "maxLength": 512},
        "attributionUrl": {"type": "string", "maxLength": 2048},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "fetchedAt": {"$ref": "common.schema.json#/$defs/Timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"hosted": {"const": true}}, "required": ["hosted"]},
          "then": {"required": ["sha256", "mime", "width", "height", "sourceUrl", "license", "attribution", "attributionUrl"]},
          "else": {"not": {"anyOf": [{"required": ["sha256"]}, {"required": ["mime"]}]}}
        }
      ]
    },
    "CatalogueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "key", "ids", "updatedAt", "assets"],
      "properties": {
        "version": {"const": 1},
        "kind": {"enum": ["author", "institution", "paper"]},
        "key": {"type": "string", "maxLength": 80},
        "ids": {"$ref": "#/$defs/Ids"},
        "updatedAt": {"$ref": "common.schema.json#/$defs/Timestamp"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/Asset"}}
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "counts", "hostedBytes"],
      "properties": {
        "version": {"const": 1},
        "generatedAt": {"$ref": "common.schema.json#/$defs/Timestamp"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author", "institution", "paper", "hostedFiles", "linkOnly"],
          "properties": {
            "author": {"type": "integer", "minimum": 0},
            "institution": {"type": "integer", "minimum": 0},
            "paper": {"type": "integer", "minimum": 0},
            "hostedFiles": {"type": "integer", "minimum": 0},
            "linkOnly": {"type": "integer", "minimum": 0}
          }
        },
        "hostedBytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
